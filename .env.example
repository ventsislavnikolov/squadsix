# Neon Postgres (pooled URL).
DATABASE_URL=
# Admin sign-in. Hash: node scripts/hash-password.mjs '<password>'
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Jev, through OpenRouter. Without it, teams are picked by arithmetic only (with a warning).
OPENROUTER_API_KEY=
# Radar nowcast for the hours before a game (rainbow.ai). Optional: without it the
# weather card shows the forecast only.
RAINBOW_API_KEY=
